# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Or use a complete connection string
DATABASE_URL=postgresql://your_db_username:your_db_password@localhost:5432/your_database_name

# Authentication
ACCESS_JWT_SECRET=replace_with_a_random_secret
REFRESH_JWT_SECRET=replace_with_a_random_secret

# Email
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Sessions
COOKIE_KEY=replace_with_a_random_secret
SESSION_SECRET=replace_with_a_random_secret